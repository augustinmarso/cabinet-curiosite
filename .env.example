# Copiez ce fichier en .env et collez vos clés (le fichier .env n'est jamais servi au navigateur).

# Taille réelle des objets — Google AI Studio : https://aistudio.google.com/apikey
# Offre gratuite disponible (sur l'offre gratuite, Google peut utiliser les données pour améliorer ses produits).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Image → 3D — https://fal.ai/dashboard/keys
# Aperçu TRELLIS ≈ 0,02 $ ; version impression Hunyuan3D v2 (maillage blanc) ≈ 0,16 $
FAL_KEY=
